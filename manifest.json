{
    "id": "flow_cytometry",
    "name": "Flow Cytometry Workspace",
    "version": "0.6.8",
    "manifest_version": 2,
    "min_core_version": "1.2.4",
    "description": "Scientist-centric flow cytometry analysis with FMO-guided gating, adaptive gates, workflow templates, and full workspace control.",
    "authors": [
        {
            "name": "Kalaimaran Balasothy",
            "role": "Lead Developer",
            "details": "Original creator of the BioPro Flow Gating Engine.",
            "permissions": [
                "sign_code"
            ]
        }
    ],
    "icon": "🧪",
    "release_notes": "Fixed FCS loading bug by adding missing flowkit dependencies (flowutils, flowio, etc) and restoring flowkit logic.",
    "custom_exclusions": [
        "tests"
    ],
    "python_dependencies": {
        "numpy": ">=1.26,<2.0.0",
        "pandas": ">=2.0",
        "matplotlib": ">=3.8",
        "scipy": ">=1.14,<1.18.0",
        "flowkit": ">=1.0",
        "fcsparser": ">=0.2",
        "flowutils": ">=1.0",
        "flowio": ">=1.2",
        "anytree": ">=2.8",
        "lxml": ">=4.9",
        "networkx": ">=2.8",
        "bokeh": ">=3.0",
        "contourpy": ">=1.0",
        "psutil": ">=5.9",
        "fast-histogram": ">=0.12",
        "umap-learn": ">=0.5",
        "hdbscan": ">=0.8",
        "seaborn": ">=0.13",
        "scikit-learn": ">=1.3",
        "python-dateutil": ">=2.9.0",
        "six": ">=1.16",
        "jinja2": ">=3.1",
        "markupsafe": ">=3.0",
        "narwhals": ">=2.0",
        "packaging": ">=24.0",
        "pillow": ">=11.0",
        "pyyaml": ">=6.0",
        "tornado": ">=6.4",
        "xyzservices": ">=2025.0",
        "cycler": ">=0.12",
        "fonttools": ">=4.50",
        "kiwisolver": ">=1.4",
        "pyparsing": ">=3.1",
        "joblib": ">=1.4",
        "threadpoolctl": ">=3.5",
        "numba": ">=0.60",
        "llvmlite": ">=0.40",
        "pynndescent": ">=0.5",
        "tqdm": ">=4.60",
